# Database (SQLite by default; easily switchable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Auth Secret (used for HMAC session signing)
AUTH_SECRET="dev-super-secret-key-change-in-production-32chars"

# Server / App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage Driver: "local" (default)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"

# Queue / Redis (Optional - defaults to DB-backed job queue when REDIS_URL is unset)
REDIS_URL=""
WORKER_CONCURRENCY="3"
WORKER_POLL_INTERVAL_MS="1500"

# Cost & Quotas
DAILY_SCENE_QUOTA="30"
STORYBOARD_HOURLY_LIMIT="5"
ESTIMATED_COST_PER_SECOND_USD="0.05"

# Provider Selection:
# LLM_PROVIDER: "mock" | "openai" | "anthropic"
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# VIDEO_PROVIDER: "mock" | "veo"
VIDEO_PROVIDER="mock"
GEMINI_API_KEY=""
VEO_MODEL="veo-2.0-generate-001"

# TTS_PROVIDER: "mock" | "openai" | "elevenlabs"
TTS_PROVIDER="mock"
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID_VI="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_VOICE_ID_EN="21m00Tcm4TlvDq8ikWAM"
OPENAI_TTS_MODEL="tts-1"

# MUSIC_PROVIDER: "mock"
MUSIC_PROVIDER="mock"

# Logging & Observability
LOG_LEVEL="info"
SENTRY_DSN=""

